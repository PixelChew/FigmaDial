{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["ES2020", "DOM"],
		"module": "ES2022",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"typeRoots": ["../node_modules/@figma", "../node_modules/@types"]
	},
	"include": ["src/**/*.ts", "../protocol/src/**/*.ts"]
}
